# Backend Environment Variables
DATABASE_URL=postgresql+asyncpg://idp_user:idp_secret@localhost:5432/idp_db
CORS_ORIGINS=["http://localhost:5173"]

# ── JWT ──────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Google OAuth ─────────────────────────────────────────────────
# Obtain from: Google Cloud Console → APIs & Services → Credentials
# Required for Google Sign-In support. Leave empty to disable Google auth.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── AI ───────────────────────────────────────────────────────────
GEMINI_API_KEY=your_key
# DevHub Environment Configuration (Docker Compose)

# ── Google OAuth ─────────────────────────────────────────────────
# Obtain from: Google Cloud Console → APIs & Services → Credentials
# Required for Google Sign-In support. Leave empty to disable Google auth.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-key-change-in-production

# ── Google Gemini API ────────────────────────────────────────────
GEMINI_API_KEY=

# ── GitHub MCP Server ────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_ORG=academic-idp

# ── Kubernetes & ArgoCD ──────────────────────────────────────────
KUBECONFIG=
ARGOCD_URL=
ARGOCD_TOKEN=
